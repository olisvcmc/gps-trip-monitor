{
  "name": "gps-trip-monitor",
  "displayName": "GPS Trip Monitor",
  "version": "1.0.0",
  "description": "Monitoring perjalanan real-time berbasis GPS dengan peta Leaflet, dibangun di atas Apache Cordova.",
  "main": "index.js",
  "scripts": {
    "postinstall": "cordova prepare"
  },
  "cordova": {
    "plugins": {
      "cordova-plugin-geolocation": {},
      "cordova-plugin-whitelist": {},
      "cordova-plugin-device": {},
      "cordova-plugin-statusbar": {},
      "cordova-background-geolocation-lt": {},
      "cordova-sqlite-storage": {},
      "cordova-plugin-network-information": {}
    },
    "platforms": [
      "android"
    ]
  },
  "devDependencies": {
    "cordova-android": "^15.1.0",
    "cordova-plugin-device": "^2.1.0",
    "cordova-plugin-geolocation": "^4.1.0",
    "cordova-plugin-statusbar": "^3.0.0",
    "cordova-plugin-whitelist": "^1.3.5",
    "cordova-background-geolocation-lt": "^4.10.3",
    "cordova-sqlite-storage": "^6.1.0",
    "cordova-plugin-network-information": "^3.0.0"
  }
}
